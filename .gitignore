# Python
__pycache__/
*.pyc
*.egg-info/

# Virtual environments
.venv/
.uv/
venv/
dissertation_env/

# Jupyter notebooks (commit code, not outputs)
.ipynb_checkpoints/

# Environment / secrets
.env

# Data (all generated — batches, checkpoints, results, raw/processed)
# Anchored to repo root: an unanchored "data/" also matches src/data/,
# which silently hid new files there (found when src/data/ult_plt.py never
# showed up in `git status` despite being a brand-new file).
/data/

# Fine-tuning outputs (adapters + checkpoints — regenerable from configs)
data/finetune/

# Model weights & checkpoints
*.bin
*.safetensors
*.ckpt
*.pt
*.pth

# Logs & experiment tracking
logs/
wandb/
.cache/

# Model call logs / result files
*.jsonl

# OS
.DS_Store

# Regenerable analysis outputs — hand-authored docs (e.g. analysis/README.md)
# are NOT covered by this and should be tracked normally.
analysis/*.csv
analysis/*.xlsx
analysis/figures/

# Regenerable paper build outputs — references.yaml (source of truth) and
# sections/*.tex (hand-written) are NOT covered by this and are tracked
# normally. `make` regenerates everything below from source before compiling.
paper/references.bib
paper/values.tex
paper/table1.tex
paper/*.pdf
paper/*.docx
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk